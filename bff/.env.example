# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gen AI (@google/genai)
GOOGLE_API_KEY=your-gemini-api-key

# Open Source Geospatial Stack (100% Gratuito - 0 API Keys requeridas por defecto)
# Opcional: si configuras ORS_API_KEY, se activa automáticamente OpenRouteService perfil wheelchair
# ORS_API_KEY=your-openrouteservice-key
ORS_BASE_URL=https://api.openrouteservice.org
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=ViaLibreHackaton/1.0 (https://github.com/HackatonUVM/vialibre)

# Google Maps Platform (OBSOLETO / OPCIONAL - Reemplazado por Valhalla, OSRM, Open-Meteo y Photon)
# GOOGLE_MAPS_SERVER_KEY=
